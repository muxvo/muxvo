          "path": "/Users/rl/dev/muxvo/src/main.ts",
          "name": "main.ts",
          "fileType": "code",
          "content": "import { spawn } from 'node:child_process';\n\nexport interface TermSpec {\n  id: string;\n  cwd: string;\n  cols: number;\n  rows: number;\n}\n\nexport function launch(spec: TermSpec): number {\n  const child = spawn('/bin/zsh', ['-l'], {\n    cwd: spec.cwd,\n    env: { TERM: 'xterm-256color' },\n  });\n  return child.pid ?? -1;\n}\n"
        }
      ],
      "dialog": null
